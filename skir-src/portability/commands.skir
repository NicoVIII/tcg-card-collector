// Same opaque-text contract as ExportData, in reverse (ADR 0019): the wire
// never parses the file, it only carries it to Portability's own decoder.
struct ImportDataRequest {
  content: string = 0;
}

// Duplicated from queries.skir: skir has no cross-file import usable with
// this repo's nested skir-gleam-gen outDir (see InventoryPlanning's
// Finish/Language for precedent).
struct SectionCount {
  section: string = 0;
  count: int32 = 1;
}

// Duplicated from queries.skir, like SectionCount.
enum PlacedIn {
  cascade: string = 1;
  managed: string = 2;
}

struct LedgerPrune {
  identity: string = 0;
  location: PlacedIn = 1;
  quantity: int32 = 2;
}

struct ImportedData {
  removed 0;  // was entry_count: superseded by sections (#119: more than the collection)
  sections: [SectionCount] = 1;
  // The ledger rows pruned right after this import, for the collector to
  // check against those locations.
  pruned: [LedgerPrune] = 2;
}

method ImportData(
  ImportDataRequest
): ImportedData = 703;
