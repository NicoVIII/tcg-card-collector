struct ExportDataRequest {
  unit: bool = 0;
}

// The exported document as opaque text: the file's shape is Portability's
// own, versioned separately from this contract (ADR 0019), so the contract
// only carries it, never parses or re-describes it.
struct ExportFile {
  filename: string = 0;
  content: string = 1;
}

method ExportData(
  ExportDataRequest
): ExportFile = 701;

// Same opaque-text contract as ExportData, in reverse (ADR 0019): the wire
// never parses the file, it only carries it to Portability's own decoder.
struct PreviewImportRequest {
  content: string = 0;
}

// One rejected entry, identified by its 1-based position in the document's
// section array plus its raw identity — a line number doesn't survive a
// hand edit's reformatting the way a position does. #119 widened the
// document beyond the collection alone, so a rejection now also names its
// section, e.g. "collection" or "insights.target_sets".
struct RejectedEntry {
  position: int32 = 0;
  identity: string = 1;
  reason: string = 2;
  section: string = 3;
}

// One section's valid-entry count — present only for a section the file
// actually had (ADR 0019: a section absent from the file, e.g. an export
// written before #119, is left untouched rather than shown as zero).
struct SectionCount {
  section: string = 0;
  count: int32 = 1;
}

// A placed-ledger copy the imported collection doesn't own enough of —
// computed up front so the preview can say what ReconcilePlacedLedger will
// prune after import (ADR 0011, ADR 0019). Always empty until #119 adds the
// inventory_planning section.
struct LedgerExcess {
  identity: string = 0;
  placed: int32 = 1;
  owned: int32 = 2;
}

struct ImportPreview {
  removed 0;  // was entry_count: superseded by sections (#119: more than the collection)
  rejected: [RejectedEntry] = 1;
  sections: [SectionCount] = 2;
  excess: [LedgerExcess] = 3;
}

method PreviewImport(
  PreviewImportRequest
): ImportPreview = 702;
