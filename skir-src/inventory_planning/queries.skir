struct InventoryRule {
  id: string = 0;
  location_name: string = 1;
  expression: string = 2;
  position: int32 = 3;
  selector: string = 4;
  sort_keys: string = 5;
}

struct InventoryRuleList {
  data: [InventoryRule] = 0;
  total: int32 = 1;
}

struct ListInventoryRulesRequest {
  unit: bool = 0;
}

method ListInventoryRules(
  ListInventoryRulesRequest
): InventoryRuleList = 303;

struct InventoryProjectionRequest {
  unit: bool = 0;
}

// The identity of a kind of owned physical copy is (printing, finish,
// language) — ADR 0010. Both value sets are closed; skir has no cross-file
// import usable with this repo's nested skir-gleam-gen outDir, so they're
// declared once per contract file that needs them (also in commands.skir).
enum Finish {
  nonfoil = 1;
  foil = 2;
  etched = 3;
}

enum Language {
  en = 1;
  es = 2;
  fr = 3;
  de = 4;
  it = 5;
  pt = 6;
  ja = 7;
  ko = 8;
  ru = 9;
  zhs = 10;
  zht = 11;
  he = 12;
  la = 13;
  grc = 14;
  ar = 15;
  sa = 16;
  ph = 17;
  qya = 18;
}

struct ProjectionCard {
  name: string = 0;
  set_code: string = 1;
  collector_number: string = 2;
  quantity: int32 = 3;
  color_identity: string = 4;
  rarity: string = 5;
  card_type: string = 6;
  finish: Finish = 7;
  language: Language = 8;
}

// The sort DSL's vocabulary (domain/sort_spec.gleam), typed here so a
// section's parts don't repeat the DSL's own strings for the wire.
enum SortKey {
  color_identity = 1;
  type = 2;
  name = 3;
  set_code = 4;
  collector_number = 5;
  rarity = 6;
  released_at = 7;
  cmc = 8;
  language = 9;
}

// One sort key's category value for a section (#138): `first == last` means
// every card in the section shares that one value; a differing pair means
// the part is a merged range ("CMC 1-3", "A-E").
struct SectionPart {
  key: SortKey = 0;
  first: string = 1;
  last: string = 2;
}

// A contiguous, divider-worthy run of a location's sorted cards — parts is
// empty when the location has no sort keys, or when nothing in it was worth
// dividing on. `card_count` is copies, not distinct cards.
struct ProjectionSection {
  parts: [SectionPart] = 0;
  card_count: int32 = 1;
}

struct ProjectionLocation {
  location_name: string = 0;
  rule_id: string = 1;
  total_quantity: int32 = 2;
  cards: [ProjectionCard] = 3;
  // Sections partition `cards` in order: walking sections and consuming
  // `card_count` copies (summing consecutive cards' `quantity`, not their
  // count) at a time lines each card up with its section.
  sections: [ProjectionSection] = 4;
}

struct InventoryProjection {
  locations: [ProjectionLocation] = 0;
  total_quantity: int32 = 1;
  unknown_count: int32 = 2;
}

method GetInventoryProjection(
  InventoryProjectionRequest
): InventoryProjection = 304;

struct BulkSpec {
  location_name: string = 0;
  sort_keys: string = 1;
}

struct GetBulkSpecRequest {
  unit: bool = 0;
}

method GetBulkSpec(
  GetBulkSpecRequest
): BulkSpec = 305;

struct PlacedLedgerRequest {
  unit: bool = 0;
}

struct PlacedLedgerRow {
  set_code: string = 0;
  collector_number: string = 1;
  location: string = 2;
  quantity: int32 = 3;
  finish: Finish = 4;
  language: Language = 5;
}

// Reuses method 306's response slot: the placement page no longer fetches
// server-composed guidance, only the raw placed ledger it folds against the
// projection client-side. Old fields stay tombstoned per the atomic-contract
// evolution rules (skir tracks the response record by method number).
struct PlacedLedger {
  removed 0;  // was locations: [PlacementLocation]
  removed 1;  // was total_unplaced: int32
  rows: [PlacedLedgerRow] = 2;
}

method GetPlacedLedger(
  PlacedLedgerRequest
): PlacedLedger = 306;
