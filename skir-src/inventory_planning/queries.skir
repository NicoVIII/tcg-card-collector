struct InventoryRule {
  id: string = 0;
  location_name: string = 1;
  expression: string = 2;
  position: int32 = 3;
  selector: string = 4;
}

struct InventoryRuleList {
  data: [InventoryRule] = 0;
  total: int32 = 1;
}

struct ListInventoryRulesRequest {
  unit: bool = 0;
}

method ListInventoryRules(
  ListInventoryRulesRequest
): InventoryRuleList = 303;

struct InventoryProjectionRequest {
  sort_by: string = 0;
  group_by: string = 1;
}

struct InventoryProjectionRow {
  location_name: string = 0;
  card_name: string = 1;
  set_code: string = 2;
  quantity: int32 = 3;
  group_value: string = 4;
}

struct InventoryProjection {
  data: [InventoryProjectionRow] = 0;
  total: int32 = 1;
}

method GetInventoryProjection(
  InventoryProjectionRequest
): InventoryProjection = 304;

struct PlanningPreferences {
  default_sort: string = 0;
  default_grouping: string = 1;
}

struct GetPlanningPreferencesRequest {
  unit: bool = 0;
}

method GetPlanningPreferences(
  GetPlanningPreferencesRequest
): PlanningPreferences = 402;

struct BulkSpec {
  location_name: string = 0;
  sort_keys: string = 1;
}

struct GetBulkSpecRequest {
  unit: bool = 0;
}

method GetBulkSpec(
  GetBulkSpecRequest
): BulkSpec = 305;
