struct UpsertInventoryRuleRequest {
  id: string = 0;
  location_name: string = 1;
  expression: string = 2;
  position: int32 = 3;
  selector: string = 4;
  sort_keys: string = 5;
}

enum UpsertInventoryRuleResponse {
  success = 1;
  error = 2;
}

method UpsertInventoryRule(
  UpsertInventoryRuleRequest
): UpsertInventoryRuleResponse = 301;

struct DeleteInventoryRuleRequest {
  id: string = 0;
}

enum DeleteInventoryRuleResponse {
  success = 1;
  error = 2;
}

method DeleteInventoryRule(
  DeleteInventoryRuleRequest
): DeleteInventoryRuleResponse = 302;

struct ReorderInventoryRulesRequest {
  ordered_ids: [string] = 0;
}

enum ReorderInventoryRulesResponse {
  success = 1;
  error = 2;
}

method ReorderInventoryRules(
  ReorderInventoryRulesRequest
): ReorderInventoryRulesResponse = 309;

struct UpdateBulkSpecRequest {
  location_name: string = 0;
  sort_keys: string = 1;
}

enum UpdateBulkSpecResponse {
  success = 1;
  error = 2;
}

method UpdateBulkSpec(
  UpdateBulkSpecRequest
): UpdateBulkSpecResponse = 403;

// The identity of a kind of owned physical copy is (printing, finish,
// language) — ADR 0010. Both value sets are closed; skir has no cross-file
// import usable with this repo's nested skir-gleam-gen outDir, so they're
// declared once per contract file that needs them (also in queries.skir).
enum Finish {
  nonfoil = 1;
  foil = 2;
  etched = 3;
}

enum Language {
  en = 1;
  es = 2;
  fr = 3;
  de = 4;
  it = 5;
  pt = 6;
  ja = 7;
  ko = 8;
  ru = 9;
  zhs = 10;
  zht = 11;
  he = 12;
  la = 13;
  grc = 14;
  ar = 15;
  sa = 16;
  ph = 17;
  qya = 18;
}

// Where a copy sits, in one of two namespaces (#122): a cascade location —
// a rule target or the bulk remainder — by its rendered name (ADR 0014's
// text), or a managed location by its id. Duplicated in queries.skir for the same
// reason as Finish/Language.
enum LocationRef {
  cascade: string = 1;
  managed: string = 2;
}

struct CardPlacement {
  set_code: string = 0;
  collector_number: string = 1;
  removed 2;  // was location_name: string, superseded by location (#122)
  quantity: int32 = 3;
  finish: Finish = 4;
  language: Language = 5;
  location: LocationRef = 6;
}

struct MarkCardsPlacedRequest {
  placements: [CardPlacement] = 0;
}

enum MarkCardsPlacedResponse {
  success = 1;
  error = 2;
}

method MarkCardsPlaced(
  MarkCardsPlacedRequest
): MarkCardsPlacedResponse = 307;

struct UnmarkCardsPlacedRequest {
  placements: [CardPlacement] = 0;
}

enum UnmarkCardsPlacedResponse {
  success = 1;
  error = 2;
}

method UnmarkCardsPlaced(
  UnmarkCardsPlacedRequest
): UnmarkCardsPlacedResponse = 308;

// Re-points every placed_cards row at one cascade location onto another in a
// single atomic write, with no CopyKey involved — the ledger bookkeeping fix
// for a rule-target rename (#107), as opposed to MarkCardsPlaced/
// UnmarkCardsPlaced which record a physical move of specific copies. Managed
// locations never need it: their rows key on an id a rename doesn't change.
struct RelocatePlacedCardsRequest {
  from_location_name: string = 0;
  to_location_name: string = 1;
}

enum RelocatePlacedCardsResponse {
  success = 1;
  error = 2;
}

method RelocatePlacedCards(
  RelocatePlacedCardsRequest
): RelocatePlacedCardsResponse = 310;

// Managed locations (#122, ADR 0022): a named location whose contents are an
// explicit membership list. Only decks so far. Duplicated in queries.skir for
// the same reason as Finish/Language.
enum ManagedLocationKind {
  deck = 1;
}

// One kind of copy and how many — a membership change, always positive.
struct ManagedCopy {
  set_code: string = 0;
  collector_number: string = 1;
  finish: Finish = 2;
  language: Language = 3;
  quantity: int32 = 4;
}

// The id is client-generated (a UUID), the same as an inventory rule's. An
// empty or duplicate name, or a reused id, is a 400.
struct CreateManagedLocationRequest {
  id: string = 0;
  name: string = 1;
  kind: ManagedLocationKind = 2;
}

struct ManagedLocationCreated {
  unit: bool = 0;
}

method CreateManagedLocation(
  CreateManagedLocationRequest
): ManagedLocationCreated = 311;

// Changes only the display name; placed-ledger rows key on the id.
struct RenameManagedLocationRequest {
  id: string = 0;
  name: string = 1;
}

struct ManagedLocationRenamed {
  unit: bool = 0;
}

method RenameManagedLocation(
  RenameManagedLocationRequest
): ManagedLocationRenamed = 312;

// Also removes every placed-ledger row recorded at the location, so its
// copies re-enter placement guidance at their cascade destination.
struct DeleteManagedLocationRequest {
  id: string = 0;
}

struct ManagedLocationDeleted {
  unit: bool = 0;
}

method DeleteManagedLocation(
  DeleteManagedLocationRequest
): ManagedLocationDeleted = 313;

// Claiming more copies of a key than are free (owned minus what managed
// locations already claim) rejects the whole batch with a 400.
struct AddToManagedLocationRequest {
  id: string = 0;
  copies: [ManagedCopy] = 1;
}

struct ManagedLocationMembersAdded {
  unit: bool = 0;
}

method AddToManagedLocation(
  AddToManagedLocationRequest
): ManagedLocationMembersAdded = 314;

// Removing more than the location holds rejects the whole batch with a 400.
struct RemoveFromManagedLocationRequest {
  id: string = 0;
  copies: [ManagedCopy] = 1;
}

struct ManagedLocationMembersRemoved {
  unit: bool = 0;
}

method RemoveFromManagedLocation(
  RemoveFromManagedLocationRequest
): ManagedLocationMembersRemoved = 315;
