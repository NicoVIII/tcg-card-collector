struct UpsertInventoryRuleRequest {
  id: string = 0;
  location_name: string = 1;
  expression: string = 2;
  position: int32 = 3;
  selector: string = 4;
}

enum UpsertInventoryRuleResponse {
  success = 1;
  error = 2;
}

method UpsertInventoryRule(
  UpsertInventoryRuleRequest
): UpsertInventoryRuleResponse = 301;

struct DeleteInventoryRuleRequest {
  id: string = 0;
}

enum DeleteInventoryRuleResponse {
  success = 1;
  error = 2;
}

method DeleteInventoryRule(
  DeleteInventoryRuleRequest
): DeleteInventoryRuleResponse = 302;

struct UpdatePlanningPreferencesRequest {
  default_sort: string = 0;
  default_grouping: string = 1;
}

enum UpdatePlanningPreferencesResponse {
  success = 1;
  error = 2;
}

method UpdatePlanningPreferences(
  UpdatePlanningPreferencesRequest
): UpdatePlanningPreferencesResponse = 401;

struct UpdateBulkSpecRequest {
  location_name: string = 0;
  sort_keys: string = 1;
}

enum UpdateBulkSpecResponse {
  success = 1;
  error = 2;
}

method UpdateBulkSpec(
  UpdateBulkSpecRequest
): UpdateBulkSpecResponse = 403;
