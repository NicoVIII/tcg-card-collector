struct UnmarkTargetSetRequest {
  set_code: string = 0;
}

enum UnmarkTargetSetResponse {
  success = 1;
  error = 2;
}

method UnmarkTargetSet(
  UnmarkTargetSetRequest
): UnmarkTargetSetResponse = 502;
