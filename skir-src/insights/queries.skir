struct SetCompletion {
  set_code: string = 0;
  owned: int32 = 1;
  // Absent when the set has no official size (Scryfall printed_size); the client
  // then shows the owned count without a denominator.
  total: int32? = 2;
}

struct SetCompletionList {
  data: [SetCompletion] = 0;
}

struct GetSetCompletionRequest {
  unit: bool = 0;
}

method GetSetCompletion(
  GetSetCompletionRequest
): SetCompletionList = 503;
