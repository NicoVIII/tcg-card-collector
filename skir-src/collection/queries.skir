struct ImportStatus {
  import_run_id: string = 0;
  status: string = 1;
  row_count: int32 = 2;
  source_name: string = 3;
}

struct GetLatestImportStatusRequest {
  unit: bool = 0;
}

method GetLatestImportStatus(
  GetLatestImportStatusRequest
): ImportStatus = 202;

struct CollectionCard {
  set_code: string = 0;
  collector_number: string = 1;
  quantity: int32 = 2;
}

struct CollectionCardList {
  data: [CollectionCard] = 0;
  total: int32 = 1;
  offset: int32 = 2;
  limit: int32 = 3;
}

struct ListCollectionCardsRequest {
  offset: int32 = 0;
  limit: int32 = 1;
}

method ListCollectionCards(
  ListCollectionCardsRequest
): CollectionCardList = 203;
