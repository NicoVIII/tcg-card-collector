// The identity of a kind of owned physical copy is (printing, finish,
// language) — ADR 0010. Both value sets are closed; skir has no cross-file
// import usable with this repo's nested skir-gleam-gen outDir, so they're
// declared once per contract file that needs them (also in queries.skir).
enum Finish {
  nonfoil = 1;
  foil = 2;
  etched = 3;
}

enum Language {
  en = 1;
  es = 2;
  fr = 3;
  de = 4;
  it = 5;
  pt = 6;
  ja = 7;
  ko = 8;
  ru = 9;
  zhs = 10;
  zht = 11;
  he = 12;
  la = 13;
  grc = 14;
  ar = 15;
  sa = 16;
  ph = 17;
  qya = 18;
}

struct AddCardsRow {
  set_code: string = 0;
  collector_number: string = 1;
  quantity: int32 = 2;
  finish: Finish = 3;
  language: Language = 4;
}

struct AddCardsRequest {
  removed 0;  // was add_run_id: runs no longer exist
  rows: [AddCardsRow] = 1;
}

enum AddCardsResponse {
  added = 1;
  rejected = 2;
}

method AddCards(
  AddCardsRequest
): AddCardsResponse = 204;

struct RemoveCardsRow {
  set_code: string = 0;
  collector_number: string = 1;
  quantity: int32 = 2;
  finish: Finish = 3;
  language: Language = 4;
}

struct RemoveCardsRequest {
  rows: [RemoveCardsRow] = 0;
}

enum RemoveCardsResponse {
  // "removed" collides with skir's own tombstone keyword syntax (`removed N;`).
  decremented = 1;
  rejected = 2;
}

// 201 (ImportCollection, deckstats CSV import) and 202 (the dropped
// import-run-log method it superseded) are both retired slots — the
// collection-only import path was removed in #118 once the own-format
// restore (#119) covered it. Not reused here, since RemoveCards doesn't
// replace whatever used to live there.
method RemoveCards(
  RemoveCardsRequest
): RemoveCardsResponse = 205;
