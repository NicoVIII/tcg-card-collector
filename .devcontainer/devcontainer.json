{
  "name": "tcg-card-collector",
  "image": "mcr.microsoft.com/devcontainers/base:3-resolute",
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": { },
    "ghcr.io/NicoVIII/devcontainer-features/lefthook:0": { },
    "ghcr.io/NicoVIII/devcontainer-features/just:0": {
      "version": "1.52.0"
    },
    // Server
    "ghcr.io/NicoVIII/devcontainer-features/gleam:0": {
      "version": "1.17.0"
    },
    // Client - Web
    "ghcr.io/devcontainers-extra/features/bun:1": { },
    // Container
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },
  "postCreateCommand": "sudo chmod +x ./.devcontainer/post_create.sh && ./.devcontainer/post_create.sh && cd client-web && bun install && git submodule init",
  "postStartCommand": "lefthook install && git submodule update && just skir-gen && cd client-web && bun install",
  "customizations": {
    "vscode": {
      "extensions": [
        // General
        "editorconfig.editorconfig",
        "FanaticPythoner.better-todo-tree",
        "timonwong.shellcheck",
        // Docs
        "MermaidChart.vscode-mermaid-chart",
        // API
        "TylerFibonacci.skir-language",
        // Database
        "qwtel.sqlite-viewer",
        // Webclient
        "oxc.oxc-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
