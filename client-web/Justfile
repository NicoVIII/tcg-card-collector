install:
  if [ -f bun.lock ]; then bun install --frozen-lockfile; else bun install; fi

format:
  bunx --bun oxfmt .

format-check:
  find src -type f \( -name '*.ts' -o -name '*.tsx' \) ! -path 'src/data/skirout/*' | xargs bunx --bun oxfmt --check

type-check:
  bun run typecheck

lint:
  bun run lint

test:
  bun run test

build:
  bun run build

dev:
  bun run dev
