{
  "name": "tcg-card-collector-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && oxlint --ignore-pattern src/data/skirout/** .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment node",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tanstack/solid-query": "^5.59.18",
    "skir-client": "^1.0.19",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-solid": "^0.14.5",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "5.5.4",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.11.1",
    "vitest": "^2.1.6"
  }
}
