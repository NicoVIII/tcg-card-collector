{
  "name": "tcg-card-collector-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "find src -type f \\( -name '*.ts' -o -name '*.tsx' \\) ! -path 'src/data/skirout/*' | xargs oxfmt",
    "format-check": "find src -type f \\( -name '*.ts' -o -name '*.tsx' \\) ! -path 'src/data/skirout/*' | xargs bunx --no-install --bun oxfmt --check",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && oxlint --ignore-pattern src/data/skirout/** .",
    "test": "vitest run --environment node"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-query": "^5.59.18",
    "@yornaath/batshit": "^0.14.0",
    "skir-client": "^1.0.19",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-solid": "^0.13.2",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "5.5.4",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.11.1",
    "vitest": "^2.1.6"
  }
}
